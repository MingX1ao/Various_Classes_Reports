ORG  0000H
		LJMP START
		ORG  0003H
		LJMP EINT0
		ORG  0100H		; ???
START:		MOV  R0, #30H   		; ?????????
		MOV  R2, #08H   		; ??8??????
		SETB IT0			; ??????0???????
		SETB EA 			; CPU????
		SETB EX0			; ??????0??
LOOP:		MOV  DPTR, #0000H	; ????????IN0
		MOVX @DPTR, A		; ??A/D??,A?????
		LCALL DELAY		; ??,??A/D????
		SJMP START
		
DELAY:    MOV  R5,#050
DELAYY:  DJNZ R5,DELAYY
               RET

	ORG  0200H		; ??????
EINT0:	MOVX A, @DPTR		; ?????????
	MOV  @R0, A		; ????RAM??
	MOV  P1, A
	INC  DPTR		; ????????
	INC  R0			; ???????????
	DJNZ R2, NEXT		; 8?????,???
	CLR  EA			; ????,????
	CLR  EX0			; ??????0??
	RETI			; ????
NEXT:	MOVX @DPTR, A		; ????A/D??
	RETI			; ????
END