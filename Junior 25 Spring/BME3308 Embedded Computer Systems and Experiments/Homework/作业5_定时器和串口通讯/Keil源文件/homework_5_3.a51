ORG 	0000H
LJMP	START

ORG		0003H
LJMP	ITR0

ORG		0040H
START:
		MOV		TMOD,	#00100001B		; ??????,T1?????2,T0?????0
		MOV		SP,		#60H
		SETB	EA
		SETB	EX0
		SETB	IT0
		MOV		TH0,	#0H
		MOV		TL0,	#0H
		MOV		SCON,	#01010000B		; ?????,?????1
		MOV		TH1,	#0FDH			; ??????9600
		MOV		TL1,	#0FDH			; ??????
		SETB	TR1	
		SJMP	$
		
		
COMMUNITY:
		PUSH	ACC
		MOV		A,		R1				; ????
		SUBB	A,		30H
		JNZ		NEXT
		MOV		A,		R2
		SUBB	A,		31H
		JZ		OUT
NEXT:	MOV		A,		R1	
		MOV		30H,	A				
		MOV		SBUF,	A				; ????????
		JNB		TI,		$
		CLR		TI
		MOV		A,		R2				; ????
		MOV		31H,	A				
		MOV		SBUF,	A				; ????????
		JNB		TI,		$
		CLR		TI
OUT:	POP		ACC
		RET

ITR0:	
		CLR		TR0						; ??????,??????
		CLR		EX0
		MOV		R1,		TH0				; ??????
		MOV		R2,		TL0
		MOV		TH0,	#0H				; ??
		MOV		TL0,	#0H
		LCALL	COMMUNITY				; ??????
		SETB	EX0
		SETB	TR0						; ?????????
		RETI
		
END