ORG 0000H
		LJMP INIT

ORG 0400H
INIT:
		MOV		10H,	#02H
		MOV		00H,	#01H

BSTART:	CLR   EA
		MOV  TMOD,#20H
		MOV  TH1,#0F4H
		MOV  TL1,#0F4H
		MOV  PCON,#00H
		SETB  TR1
		MOV  SCON,#50H     ;??????1,?????
BLOOP1:	JNB  RI,$            ;??1??????? 
		CLR  RI               
		MOV  A,SBUF        ;??1????   
		XRL  A,#0E1H         ;????1??????
		JNZ   BLOOP1          ;??1??????,???   
		MOV  SBUF,#0E2H     ;?1??????,?????
		JNB   TI,$       
		CLR   TI  
		MOV  R0,#40H        ;???????????
		MOV  R7,#10H        ;?????????
		MOV  R6,#00H        ;??????
BLOOP2:	JNB  RI,$
		CLR   RI  
		MOV  A,SBUF
		MOV  @R0,A          ;??????
		INC   R0  
		ADD  A,R6           ;???? 
		MOV  R6,A
		DJNZ  R7,BLOOP2    ;??????????
		JNB  RI,$             ;??,??1????????
		CLR  RI
		MOV  A,SBUF
		XRL  A,R6            ;?????
		JZ   END1             ;?????,???????
		MOV  SBUF,#0FFH    ;??????,?????  
		JNB  TI,$             ;?????
		CLR  TI
END1:	MOV  SBUF,#00H
		RET

END